config {
  type: "view",
  schema: dataform.projectConfig.vars.silver_dataset,
  name: "vw_obs_ingestion_volume",
  description: "Observability View for Looker Studio Card 4: Daily Ingestion Volume and Record Deltas.",
  tags: ["observability"],
  dependencies: ["stg_ebs_oe_order_headers", "stg_ebs_oe_order_lines", "stg_ebs_hz_cust_accounts"]
}

SELECT
  'stg_ebs_oe_order_headers' AS table_name,
  DATE(silver1_ingestion_timestamp) AS ingestion_date,
  COUNT(1) AS total_records_processed,
  MAX(silver1_ingestion_timestamp) AS latest_ingestion_timestamp
FROM
  ${ref("stg_ebs_oe_order_headers")}
GROUP BY 1, 2

UNION ALL

SELECT
  'stg_ebs_oe_order_lines' AS table_name,
  DATE(silver1_ingestion_timestamp) AS ingestion_date,
  COUNT(1) AS total_records_processed,
  MAX(silver1_ingestion_timestamp) AS latest_ingestion_timestamp
FROM
  ${ref("stg_ebs_oe_order_lines")}
GROUP BY 1, 2

UNION ALL

SELECT
  'stg_ebs_hz_cust_accounts' AS table_name,
  DATE(silver1_ingestion_timestamp) AS ingestion_date,
  COUNT(1) AS total_records_processed,
  MAX(silver1_ingestion_timestamp) AS latest_ingestion_timestamp
FROM
  ${ref("stg_ebs_hz_cust_accounts")}
GROUP BY 1, 2
