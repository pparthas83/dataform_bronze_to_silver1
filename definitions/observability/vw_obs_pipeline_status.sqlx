config {
  type: "view",
  schema: dataform.projectConfig.vars.silver_dataset,
  name: "vw_obs_pipeline_status",
  description: "Observability View for Looker Studio Card 1: Pipeline Execution Status, Job Counts, and Durations.",
  tags: ["observability"]
}

SELECT
  job_id,
  job_type,
  statement_type,
  state,
  error_result.reason AS failure_reason,
  error_result.message AS failure_message,
  creation_time,
  start_time,
  end_time,
  TIMESTAMP_DIFF(end_time, start_time, SECOND) AS duration_seconds,
  total_bytes_billed,
  ROUND(total_bytes_billed / (1024 * 1024 * 1024), 4) AS gb_billed,
  total_slot_ms
FROM
  `region-us`.INFORMATION_SCHEMA.JOBS_BY_PROJECT
WHERE
  creation_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)
  AND (
    destination_table.dataset_id = '${dataform.projectConfig.vars.silver_dataset}'
    OR destination_table.dataset_id = '${dataform.projectConfig.assertionSchema}'
  )
