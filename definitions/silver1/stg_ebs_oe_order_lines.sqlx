config {
  type: "incremental",
  schema: dataform.projectConfig.vars.silver_dataset,
  name: "stg_ebs_oe_order_lines",
  description: "Deduplicated and standardized Oracle EBS Order Lines in Silver 1 dataset.",
  uniqueKey: ["line_id"],
  dependencies: ["stg_ebs_oe_order_headers"],
  bigquery: {
    partitionBy: "DATE(ordered_date)",
    clusterBy: ["header_id", "line_id"]
  },
  assertions: {
    uniqueKey: ["line_id"],
    nonNull: ["line_id", "header_id", "ordered_quantity"]
  },
  columns: {
    line_id: "Primary Key - Oracle EBS Line ID",
    header_id: "Foreign Key - Oracle EBS Header ID",
    line_number: "Line sequence number within order",
    inventory_item_id: "Inventory Item ID",
    ordered_item: "Item Number / SKU string",
    ordered_quantity: "Quantity ordered",
    shipped_quantity: "Quantity shipped",
    cancelled_quantity: "Quantity cancelled",
    unit_selling_price: "Unit selling price",
    unit_list_price: "Unit list price",
    extended_price: "Calculated total line price (ordered_quantity * unit_selling_price)",
    ordered_date: "Order placement timestamp",
    flow_status_code: "Line Status (e.g. AWAITING_SHIPPING, SHIPPED, CLOSED)",
    creation_date: "Record creation timestamp in EBS",
    last_update_date: "Last update timestamp in EBS",
    silver1_ingestion_timestamp: "Timestamp when record was materialized into Silver 1"
  }
}

WITH raw_lines AS (
  SELECT
    CAST(LINE_ID AS INT64) AS line_id,
    CAST(HEADER_ID AS INT64) AS header_id,
    CAST(LINE_NUMBER AS INT64) AS line_number,
    CAST(INVENTORY_ITEM_ID AS INT64) AS inventory_item_id,
    CAST(ORDERED_ITEM AS STRING) AS ordered_item,
    CAST(ORDERED_QUANTITY AS NUMERIC) AS ordered_quantity,
    CAST(SHIPPED_QUANTITY AS NUMERIC) AS shipped_quantity,
    CAST(CANCELLED_QUANTITY AS NUMERIC) AS cancelled_quantity,
    CAST(UNIT_SELLING_PRICE AS NUMERIC) AS unit_selling_price,
    CAST(UNIT_LIST_PRICE AS NUMERIC) AS unit_list_price,
    CAST(ORDERED_DATE AS TIMESTAMP) AS ordered_date,
    CAST(FLOW_STATUS_CODE AS STRING) AS flow_status_code,
    CAST(CREATION_DATE AS TIMESTAMP) AS creation_date,
    CAST(LAST_UPDATE_DATE AS TIMESTAMP) AS last_update_date,
    CAST(_FIVETRAN_DELETED AS BOOL) AS is_deleted,
    CAST(_FIVETRAN_SYNCED AS TIMESTAMP) AS cdc_synced_at,
    ROW_NUMBER() OVER (
      PARTITION BY LINE_ID 
      ORDER BY LAST_UPDATE_DATE DESC, _FIVETRAN_SYNCED DESC
    ) AS row_num
  FROM
    ${ref("OE_ORDER_LINES_ALL")}
  -- Incremental filter with 2-hour safety lookback to capture late-arriving CDC records:
  ${when(incremental(), `WHERE LAST_UPDATE_DATE >= (SELECT TIMESTAMP_SUB(IFNULL(MAX(last_update_date), TIMESTAMP('1970-01-01')), INTERVAL 2 HOUR) FROM ${self()})`)}
)

SELECT
  line_id,
  header_id,
  line_number,
  inventory_item_id,
  ordered_item,
  ordered_quantity,
  IFNULL(shipped_quantity, 0) AS shipped_quantity,
  IFNULL(cancelled_quantity, 0) AS cancelled_quantity,
  unit_selling_price,
  unit_list_price,
  ROUND(ordered_quantity * unit_selling_price, 2) AS extended_price,
  ordered_date,
  flow_status_code,
  creation_date,
  last_update_date,
  CURRENT_TIMESTAMP() AS silver1_ingestion_timestamp
FROM
  raw_lines
WHERE
  row_num = 1
  AND (is_deleted IS FALSE OR is_deleted IS NULL)
