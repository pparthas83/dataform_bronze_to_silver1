config {
  type: "incremental",
  schema: dataform.projectConfig.vars.silver_dataset,
  name: "stg_ebs_oe_order_headers",
  description: "Deduplicated and standardized Oracle EBS Order Headers in Silver 1 dataset.",
  uniqueKey: ["header_id"],
  bigquery: {
    partitionBy: "DATE(ordered_date)",
    clusterBy: ["header_id", "sold_to_org_id"]
  },
  assertions: {
    uniqueKey: ["header_id"],
    nonNull: ["header_id", "order_number", "ordered_date"]
  },
  columns: {
    header_id: "Primary key - Oracle EBS Header ID",
    order_number: "Oracle Sales Order Number",
    ordered_date: "Timestamp when order was placed",
    order_type_id: "Order Type Identifier",
    sold_to_org_id: "Customer Account ID (sold to)",
    ship_to_org_id: "Shipping Location / Site ID",
    invoice_to_org_id: "Billing Location / Site ID",
    transactional_curr_code: "Currency code (e.g. USD)",
    flow_status_code: "Order Status (e.g. ENTERED, BOOKED, CLOSED)",
    creation_date: "Record creation timestamp in EBS",
    last_update_date: "Last update timestamp in EBS (used for deduplication / latest truth)",
    bq_created_timestamp: "BigQuery Bronze arrival timestamp (used as incremental watermark)",
    silver1_ingestion_timestamp: "Timestamp when record was materialized into Silver 1"
  }
}

WITH raw_headers AS (
  SELECT
    CAST(HEADER_ID AS INT64) AS header_id,
    CAST(ORDER_NUMBER AS INT64) AS order_number,
    CAST(ORDERED_DATE AS TIMESTAMP) AS ordered_date,
    CAST(ORDER_TYPE_ID AS INT64) AS order_type_id,
    CAST(SOLD_TO_ORG_ID AS INT64) AS sold_to_org_id,
    CAST(SHIP_TO_ORG_ID AS INT64) AS ship_to_org_id,
    CAST(INVOICE_TO_ORG_ID AS INT64) AS invoice_to_org_id,
    CAST(TRANSACTIONAL_CURR_CODE AS STRING) AS transactional_curr_code,
    CAST(FLOW_STATUS_CODE AS STRING) AS flow_status_code,
    CAST(CREATION_DATE AS TIMESTAMP) AS creation_date,
    CAST(LAST_UPDATE_DATE AS TIMESTAMP) AS last_update_date,
    CAST(BQ_CREATED_TIMESTAMP AS TIMESTAMP) AS bq_created_timestamp,
    CAST(_FIVETRAN_DELETED AS BOOL) AS is_deleted,
    -- Deduplication: Order by business timestamp (LAST_UPDATE_DATE) to capture latest business truth
    ROW_NUMBER() OVER (
      PARTITION BY HEADER_ID 
      ORDER BY LAST_UPDATE_DATE DESC, BQ_CREATED_TIMESTAMP DESC
    ) AS row_num
  FROM
    ${ref("OE_ORDER_HEADERS_ALL")}
  -- Incremental Watermark: Filter on BQ_CREATED_TIMESTAMP to only read newly arrived Bronze data
  ${when(incremental(), `WHERE BQ_CREATED_TIMESTAMP >= (SELECT TIMESTAMP_SUB(IFNULL(MAX(bq_created_timestamp), TIMESTAMP('1970-01-01')), INTERVAL 5 MINUTE) FROM ${self()})`)}
)

SELECT
  header_id,
  order_number,
  ordered_date,
  order_type_id,
  sold_to_org_id,
  ship_to_org_id,
  invoice_to_org_id,
  transactional_curr_code,
  flow_status_code,
  creation_date,
  last_update_date,
  bq_created_timestamp,
  CURRENT_TIMESTAMP() AS silver1_ingestion_timestamp
FROM
  raw_headers
WHERE
  row_num = 1
  AND (is_deleted IS FALSE OR is_deleted IS NULL)
